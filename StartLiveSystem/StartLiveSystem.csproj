<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StartLiveSystem</RootNamespace>
    <AssemblyName>StartLiveSystem</AssemblyName>
    <AssemblyTitle>Live System Boot Manager</AssemblyTitle>
    <Product>StartLiveSystem</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\launcher.json" Link="launcher.json" Condition="Exists('..\launcher.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
